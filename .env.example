# === Database ===
POSTGRES_DB=agentfoundry
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://app:changeme@localhost:5432/agentfoundry

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Memgraph ===
MEMGRAPH_URL=bolt://localhost:7687

# === LiteLLM ===
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=changeme

# === LLM API Keys ===
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# === Langfuse ===
LANGFUSE_SECRET=changeme
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3200

# === App ===
APP_ENV=development
SECRET_KEY=changeme

# === Production (Azure) ===
ACR_LOGIN_SERVER=yourregistry.azurecr.io
IMAGE_TAG=latest
DOMAIN=yourdomain.com
ACME_EMAIL=you@yourdomain.com
